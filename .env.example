# API key CARTO Basemaps untuk peta Supplier Terdekat (opsional).
# Minta gratis di https://carto.com/basemaps/apikey (tanpa akun, dikirim lewat email).
# Kosongkan bila tidak punya: peta otomatis memakai Esri Light Gray yang gratis tanpa key.
# Catatan: variabel VITE_ ikut terkirim ke browser, batasi domain key di dashboard CARTO.
VITE_CARTO_API_KEY=

# API key Gemini untuk Scan Struk (buat gratis di https://aistudio.google.com/apikey).
# JANGAN diberi awalan VITE_ agar tidak terkirim ke browser. Di Vercel, isi juga di
# Project Settings > Environment Variables.
GEMINI_API_KEY=
# Opsional: ganti model (default gemini-2.5-flash-lite, paling hemat).
# GEMINI_MODEL=
